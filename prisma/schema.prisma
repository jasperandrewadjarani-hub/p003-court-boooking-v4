// P003 Court Booking System v4 — Prisma schema
// Full core schema per P_003_V4MasterPlan_(2026-08).md §4.1, except Auth.js's
// own adapter tables (sessions/accounts/verification_tokens), deferred to
// Phase 2 when Auth.js is actually wired up — guessing their exact required
// shape now risks redoing it wrong.
//
// The GiST exclusion constraint (§4.2), the block_range/local_date trigger,
// and RLS enable/force/policies are NOT expressible in the Prisma schema DSL
// and are added by raw-SQL migrations layered on top of what this schema
// generates — never by application code.
//
// IMPORTANT: every DateTime field below that represents an absolute instant
// carries an explicit @db.Timestamptz(3). Prisma's default Postgres mapping
// for a bare `DateTime` field is `timestamp` WITHOUT time zone, not
// `timestamptz` — a real, empirically-discovered bug (see notes.md,
// 2026-08-12) where `AT TIME ZONE` on a naive-timestamp column silently
// computes the opposite direction of what was intended. Fields that are
// deliberately date-only (birthday, holiday date, local_date, the
// booking-sequence key) keep @db.Date instead, which has no time-zone
// ambiguity to begin with.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  // Prisma 7: the connection URL is no longer declared here at all — the
  // CLI reads it from prisma.config.ts (DIRECT_URL), and the runtime
  // PrismaClient reads it from the adapter in src/lib/db/prisma.ts
  // (DATABASE_URL, pooled). Declaring `url` here is a hard schema error now.
}

// --------------------------------- Enums -----------------------------------

enum TenantStatus {
  active
  suspended
  archived
}

enum UserKind {
  customer
  staff
}

enum StaffRole {
  owner
  admin
  staff
}

enum PasswordAlgo {
  argon2id
  sha256_v2 // legacy v2 import only; upgraded on login, 90-day sunset
}

enum CourtStatus {
  available
  maintenance
  closed
}

// v2 stores one Status per Bookings row, kept in sync across a group by
// updateBookingGroupFields_ — group and item status are conceptually the
// same vocabulary, so BookingGroup.status and Booking.status share this one
// enum rather than drifting into two. The exclusion constraint's WHERE
// clause filters on exactly these 4 "active" values (master plan §4.2),
// matching v2's activeBookingStatuses_() precisely.
enum BookingStatus {
  reserved
  confirmed
  checked_in
  playing
  finished
  cancelled
  lapsed
  no_show
}

enum PaymentStatus {
  unpaid
  awaiting_verification
  partial
  paid
  refunded
}

enum BookingSource {
  walk_in
  web_app
  phone
  staff
}

enum PaymentMethod {
  cash
  gcash
  maya
  credit_card
  bank_transfer
}

enum DiscountType {
  percentage // discountValue = percent off (1-100)
  fixed_php // discountValue = fixed amount off, in minor units (centavos)
}

enum EmailOutboxStatus {
  queued
  sent
  failed
}

// -------------------------------- Tenancy -----------------------------------

model Tenant {
  id            String       @id @default(uuid()) @db.Uuid
  slug          String       @unique
  name          String
  status        TenantStatus @default(active)
  timezone      String       @default("Asia/Manila")
  currency      String       @default("PHP")
  locale        String       @default("en-PH")
  logoUrl       String?      @map("logo_url")
  primaryColor  String?      @map("primary_color")
  accentColor   String?      @map("accent_color")
  senderName    String?      @map("sender_name")
  senderEmail   String?      @map("sender_email")
  featureFlags  Json         @default("{}") @map("feature_flags")
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  domains         TenantDomain[]
  settings        TenantSetting[]
  sessions        Session[]
  otpChallenges   OtpChallenge[]
  users           User[]
  customers       Customer[]
  staff           Staff[]
  courts          Court[]
  memberships     Membership[]
  priceMatrix     PriceMatrixRow[]
  holidays        Holiday[]
  bookingGroups   BookingGroup[]
  bookings        Booking[]
  bookingSequences BookingSequence[]
  payments        Payment[]
  discounts       Discount[]
  blockedSlots    BlockedSlot[]
  receipts        Receipt[]
  emailOutbox     EmailOutbox[]
  auditLog        AuditLog[]
  jobRuns         JobRun[]

  @@map("tenants")
}

model TenantDomain {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  hostname  String
  isPrimary Boolean  @default(false) @map("is_primary")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // No @@unique here on purpose: uniqueness is enforced by a case-insensitive
  // functional index — CREATE UNIQUE INDEX ... (lower(hostname)) — added by
  // the booking_constraints_and_rls raw-SQL migration. A plain @@unique here
  // would fight that index on every future `migrate dev` (drift Prisma can't
  // reconcile automatically). See that migration's header comment.
  @@index([tenantId])
  @@map("tenant_domains")
}

/// Typed business config — v2's Config sheet. One row per (tenant, key).
model TenantSetting {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  key       String
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, key])
  @@map("tenant_settings")
}

// ----------------------------- Identity & auth -------------------------------

/// Auth identity for both customers and staff. UNIQUE (tenant_id, lower(email))
/// enforced by a raw-SQL functional unique index (Prisma can't express lower()).
model User {
  id              String        @id @default(uuid()) @db.Uuid
  tenantId        String        @map("tenant_id") @db.Uuid
  kind            UserKind
  email           String
  passwordHash    String?       @map("password_hash")
  passwordAlgo    PasswordAlgo? @map("password_algo")
  passwordSalt    String?       @map("password_salt") // legacy sha256_v2 only
  emailVerifiedAt DateTime?     @map("email_verified_at") @db.Timestamptz(3)
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer Customer?
  staff    Staff?

  // No @@unique here on purpose: same reasoning as TenantDomain.hostname
  // above — enforced by CREATE UNIQUE INDEX ... (tenant_id, lower(email))
  // in the booking_constraints_and_rls migration instead.
  @@map("users")
}

/// v2 Customers — profile, membership, visit/spend/loyalty totals.
model Customer {
  id             String    @id @default(uuid()) @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  userId         String    @unique @map("user_id") @db.Uuid
  firstName      String    @map("first_name")
  lastName       String    @map("last_name")
  mobileNumber   String?   @map("mobile_number")
  birthday       DateTime? @db.Date
  membershipType String?   @map("membership_type")
  totalVisits    Int       @default(0) @map("total_visits")
  totalSpendMinor BigInt   @default(0) @map("total_spend_minor")
  loyaltyPoints  Int       @default(0) @map("loyalty_points")
  notes          String?
  registeredAt   DateTime  @default(now()) @map("registered_at") @db.Timestamptz(3)

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookingGroups BookingGroup[]

  @@index([tenantId])
  @@map("customers")
}

/// v2 Staff — name, position, role, active.
model Staff {
  id       String    @id @default(uuid()) @db.Uuid
  tenantId String    @map("tenant_id") @db.Uuid
  userId   String    @unique @map("user_id") @db.Uuid
  name     String
  position String?
  role     StaffRole @default(staff)
  active   Boolean   @default(true)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("staff")
}

// ------------------------------ Sessions & OTP -------------------------------
// Hand-rolled instead of Auth.js — see notes.md 2026-08-12 for the reasoning
// (no tenant-scoping hook in Auth.js's adapter model; its Credentials
// provider doesn't fit a 3-step OTP-register/password-login flow for two
// separate user kinds). Postgres tables stand in for v2's PropertiesService/
// CacheService, since Vercel functions are stateless per invocation.

/// Opaque bearer token → hashed lookup. Never store the raw token — only
/// tokenHash (SHA-256 of it). Two cookie namespaces at the application layer
/// (customer_session / staff_session) both point here, distinguished by
/// `kind`, so a customer token can never be presented as a staff token.
model Session {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  kind      UserKind
  tokenHash String   @map("token_hash")
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, tokenHash])
  @@index([tenantId, userId])
  @@map("sessions")
}

/// Short-lived email verification codes — registration and password reset.
/// codeHash only, never the raw code. One live challenge per
/// (tenant, email, purpose) at a time — a resend before expiry reuses the
/// existing row rather than issuing a second code (matches v2's
/// sendCustomerChallenge_ "already sent" behavior).
model OtpChallenge {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  emailHash String   @map("email_hash")
  purpose   String // "register" | "reset"
  codeHash  String   @map("code_hash")
  attempts  Int      @default(0)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, emailHash, purpose])
  @@map("otp_challenges")
}

// -------------------------------- Master data --------------------------------

/// v2 Courts.
model Court {
  id              String      @id @default(uuid()) @db.Uuid
  tenantId        String      @map("tenant_id") @db.Uuid
  code            String
  name            String
  indoor          Boolean     @default(true)
  status          CourtStatus @default(available)
  surface         String?
  lighting        String?
  capacity        Int         @default(4)
  airConditioned  Boolean     @default(false) @map("air_conditioned")
  baseRateMinor   Int?        @map("base_rate_minor")
  lightingFeeMinor Int?       @map("lighting_fee_minor")
  description     String?
  sortOrder       Int         @default(0) @map("sort_order")
  // Customer-facing court photo — clicking a court header opens it. Stored
  // the same way as the logo/QR (data: URI or external URL), no separate
  // storage backend needed.
  imageUrl        String?     @map("image_url")

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  bookings     Booking[]
  blockedSlots BlockedSlot[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("courts")
}

/// v2 Memberships.
model Membership {
  id              String  @id @default(uuid()) @db.Uuid
  tenantId        String  @map("tenant_id") @db.Uuid
  name            String
  monthlyFeeMinor Int     @default(0) @map("monthly_fee_minor")
  discountPercent Decimal @default(0) @map("discount_percent") @db.Decimal(5, 2)
  priorityBooking Boolean @default(false) @map("priority_booking")
  freeHoursMonth  Decimal @default(0) @map("free_hours_month") @db.Decimal(6, 2)
  active          Boolean @default(true)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("memberships")
}

/// v2 PriceMatrix — time-overlap pricing rules.
model PriceMatrixRow {
  id               String  @id @default(uuid()) @db.Uuid
  tenantId         String  @map("tenant_id") @db.Uuid
  dayType          String  @map("day_type") // "weekday" | "weekend"
  startTime        String  @map("start_time") // "HH:MM", 24h
  endTime          String  @map("end_time")
  courtType        String  @map("court_type") // "indoor" | "outdoor"
  pricePerHourMinor Int    @map("price_per_hour_minor")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, dayType, courtType])
  @@map("price_matrix")
}

/// v2 Holidays.
model Holiday {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  date           DateTime @db.Date
  name           String
  rateMultiplier Decimal  @default(1) @map("rate_multiplier") @db.Decimal(4, 2)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, date])
  @@index([tenantId])
  @@map("holidays")
}

// -------------------------------- Bookings -----------------------------------

/// The transaction group — v2's shared Booking ID across multiple court/time items.
model BookingGroup {
  id              String              @id @default(uuid()) @db.Uuid
  tenantId        String              @map("tenant_id") @db.Uuid
  reference       String?             // "BK-YYYYMMDD-NNN", assigned post-insert (master plan §4.4 step 4)
  customerId      String              @map("customer_id") @db.Uuid
  status          BookingStatus       @default(reserved)
  paymentStatus   PaymentStatus       @default(unpaid) @map("payment_status")
  source          BookingSource       @default(web_app)
  staffUserId     String?             @map("staff_user_id") @db.Uuid
  notes           String?
  totalMinor      Int                 @default(0) @map("total_minor")
  amountPaidMinor Int                 @default(0) @map("amount_paid_minor") // derived, recomputed from the Payments ledger — never written directly except by that recomputation
  idempotencyKey  String              @map("idempotency_key")
  // v3b discount model: the applied promotion code + the group-level discount
  // amount (stored once per group, subtracted once by group readers). Matches
  // v3b's Bookings-sheet "Discount Code" / "Discount Amount" (first-row-only).
  discountId          String?         @map("discount_id") @db.Uuid
  discountCode        String?         @map("discount_code")
  discountAmountMinor Int             @default(0) @map("discount_amount_minor")
  createdAt       DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer Customer  @relation(fields: [customerId], references: [id], onDelete: Restrict)
  discount Discount? @relation(fields: [discountId], references: [id], onDelete: SetNull)
  bookings Booking[]
  payments Payment[]
  receipts Receipt[]

  @@unique([tenantId, idempotencyKey])
  @@unique([tenantId, reference])
  @@index([tenantId, createdAt(sort: Desc)])
  @@map("booking_groups")
}

/// One row per court/time item. block_range and local_date are set by a
/// raw-SQL BEFORE INSERT/UPDATE trigger (master plan §4.2) — never by app code.
model Booking {
  id                    String             @id @default(uuid()) @db.Uuid
  tenantId              String             @map("tenant_id") @db.Uuid
  bookingGroupId        String             @map("booking_group_id") @db.Uuid
  courtId               String             @map("court_id") @db.Uuid
  startsAt              DateTime           @map("starts_at") @db.Timestamptz(3)
  endsAt                DateTime           @map("ends_at") @db.Timestamptz(3)
  turnoverBufferMinutes Int                @map("turnover_buffer_minutes") // snapshot from tenant_settings at creation
  tz                    String             // snapshot, keeps local_date stable across tenant tz changes
  // localDate and blockRange are populated by the BEFORE INSERT/UPDATE
  // trigger from the booking_constraints_and_rls migration, never written
  // by app code. blockRange uses Unsupported() because Prisma's schema DSL
  // has no tstzrange type — this declaration exists purely so schema-diffing
  // knows the column is intentional and never proposes dropping it.
  localDate             DateTime?          @map("local_date") @db.Date
  blockRange            Unsupported("tstzrange")? @map("block_range")
  durationMinutes       Int                @map("duration_minutes")
  players               Int                @default(2)
  priceMinor            Int                @map("price_minor")
  status                BookingStatus      @default(reserved)
  createdAt             DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  bookingGroup BookingGroup @relation(fields: [bookingGroupId], references: [id], onDelete: Cascade)
  court        Court        @relation(fields: [courtId], references: [id], onDelete: Restrict)

  @@index([tenantId, bookingGroupId])
  @@index([tenantId, localDate, courtId])
  @@map("bookings")
}

/// (tenant_id, local_date) -> next_seq. Atomic reference generation, replaces
/// v2's full-sheet scan (S5). Updated via `UPDATE ... RETURNING` inside the
/// booking transaction, never read-then-write from application code.
model BookingSequence {
  tenantId  String   @map("tenant_id") @db.Uuid
  localDate DateTime @map("local_date") @db.Date
  nextSeq   Int      @default(1) @map("next_seq")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@id([tenantId, localDate])
  @@map("booking_sequences")
}

// -------------------------------- Payments & promos ---------------------------

/// v2 Payments — the authoritative collection ledger (distinct from the
/// repeated Bookings-sheet Amount Paid field it replaces). amountPaidMinor
/// on BookingGroup is recomputed FROM this ledger, never the other way.
model Payment {
  id             String        @id @default(uuid()) @db.Uuid
  tenantId       String        @map("tenant_id") @db.Uuid
  bookingGroupId String        @map("booking_group_id") @db.Uuid
  method         PaymentMethod
  amountMinor    Int           @map("amount_minor")
  discountMinor  Int           @default(0) @map("discount_minor")
  taxMinor       Int           @default(0) @map("tax_minor")
  totalMinor     Int           @map("total_minor")
  receiptNumber  String        @map("receipt_number")
  staffUserId    String?       @map("staff_user_id") @db.Uuid
  collectedAt    DateTime      @default(now()) @map("collected_at") @db.Timestamptz(3)

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  bookingGroup BookingGroup @relation(fields: [bookingGroupId], references: [id], onDelete: Restrict)

  @@unique([tenantId, receiptNumber])
  @@index([tenantId, collectedAt])
  @@index([tenantId, bookingGroupId])
  @@map("payments")
}

/// v3b Discounts — promotion codes. Faithful to v3b's DiscountService schema:
/// no date bounds (codes don't expire by date), `maxAvailments = 0` means
/// UNLIMITED (not "zero allowed"), `timesAvailed` is the atomic redemption
/// counter. Consumed inside the booking transaction via
/// `UPDATE discounts SET times_availed = times_availed + 1
///  WHERE id = ... AND (max_availments = 0 OR times_availed < max_availments)
///  RETURNING times_availed` — zero rows back means exhausted (a normal
/// outcome, not an error), matching v3b's consumeDiscountQuote_ under-lock.
model Discount {
  id             String       @id @default(uuid()) @db.Uuid
  tenantId       String       @map("tenant_id") @db.Uuid
  code           String // normalized uppercase, ^[A-Z0-9][A-Z0-9_-]{0,49}$
  discountType   DiscountType @map("discount_type")
  discountValue  Int          @map("discount_value") // percent (1-100) for percentage; minor units for fixed_php
  maxAvailments  Int          @default(0) @map("max_availments") // 0 = unlimited
  timesAvailed   Int          @default(0) @map("times_availed")
  active         Boolean      @default(true)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  bookingGroups BookingGroup[]

  @@unique([tenantId, code])
  @@index([tenantId, active])
  @@map("discounts")
}

/// v3b BlockedSlots — admin-created non-booking court closures. Distinct from a
/// court's maintenance status: a block targets a specific court + date + time
/// window. Overlap checks (block-vs-booking and block-vs-block) run inside the
/// relevant transaction, mirroring v3b's BlockedSlotService under-lock checks.
model BlockedSlot {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  courtId         String   @map("court_id") @db.Uuid
  localDate       DateTime @map("local_date") @db.Date
  startsAt        DateTime @map("starts_at") @db.Timestamptz(3)
  endsAt          DateTime @map("ends_at") @db.Timestamptz(3)
  reason          String?
  createdByUserId String?  @map("created_by_user_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  court  Court  @relation(fields: [courtId], references: [id], onDelete: Cascade)

  @@index([tenantId, localDate, courtId])
  @@map("blocked_slots")
}

// -------------------------------- Receipts & jobs ------------------------------

/// Uploaded proof-of-payment metadata. A booking group can accumulate more
/// than one upload over time (re-upload after a rejected receipt), unlike
/// v2's single overwritable Receipt URL field — verifiedBy/At tracks staff
/// review per upload rather than per booking.
model Receipt {
  id             String    @id @default(uuid()) @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  bookingGroupId String    @map("booking_group_id") @db.Uuid
  objectKey      String    @map("object_key") // Supabase Storage path once configured; "local:<id>" for the $0 Postgres-bytea fallback (src/lib/storage/receipts.ts)
  mimeType       String    @map("mime_type")
  bytes          Int
  // Only populated by the local-storage fallback transport — no Supabase
  // Storage credentials (SUPABASE_URL/SUPABASE_SERVICE_ROLE_KEY) exist yet
  // in .env.local, same situation as Resend for email (see notes.md
  // 2026-08-12). NULL once objectKey points to real Supabase Storage.
  data           Bytes?
  uploadedByUserId String  @map("uploaded_by_user_id") @db.Uuid
  uploadedAt     DateTime  @default(now()) @map("uploaded_at") @db.Timestamptz(3)
  verifiedByUserId String? @map("verified_by_user_id") @db.Uuid
  verifiedAt     DateTime? @map("verified_at") @db.Timestamptz(3)

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  bookingGroup BookingGroup @relation(fields: [bookingGroupId], references: [id], onDelete: Cascade)

  @@index([tenantId, bookingGroupId])
  @@index([tenantId, verifiedAt]) // NULL verifiedAt = pending review queue
  @@map("receipts")
}

/// Queued transactional email — enqueued post-commit inside the same request
/// that triggered it, drained out of band by a cron job (master plan §4.4,
/// §6). No user-facing request ever awaits a Resend call directly.
model EmailOutbox {
  id          String            @id @default(uuid()) @db.Uuid
  tenantId    String            @map("tenant_id") @db.Uuid
  template    String
  toAddresses String[]          @map("to_addresses")
  ccAddresses String[]          @default([]) @map("cc_addresses")
  bccAddresses String[]         @default([]) @map("bcc_addresses")
  payload     Json
  status      EmailOutboxStatus @default(queued)
  attempts    Int               @default(0)
  lastError   String?           @map("last_error")
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  sentAt      DateTime?         @map("sent_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, status, createdAt])
  @@map("email_outbox")
}

/// v2 AuditLog — actor, action, entity, details. Non-blocking by design
/// (master plan §4.4 step 5 runs it inside the cheap booking transaction,
/// but a failure here must never roll back the transaction it's logging).
model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  actorUserId String? @map("actor_user_id") @db.Uuid
  actorKind  String   @map("actor_kind") // "customer" | "staff" | "system" | "platform"
  entity     String
  entityId   String   @map("entity_id")
  action     String
  details    Json      @default("{}")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, entity, entityId])
  @@index([tenantId, createdAt(sort: Desc)])
  @@map("audit_log")
}

/// Cron idempotency — UNIQUE(tenant_id, job, window_key) means a retried or
/// overlapping cron invocation for the same job+window is a safe no-op,
/// never a duplicate run (e.g. two overlapping reminder-email sends).
model JobRun {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  job       String
  windowKey String   @map("window_key")
  ranAt     DateTime @default(now()) @map("ran_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, job, windowKey])
  @@map("job_runs")
}
